MYSQL_DATABASE=bankingpj
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_root_password

MYSQL_PORT=3306

REDIS_PORT=6379

# Export these variables to the backend process; Spring does not load .env automatically.
JWT_ACCESS_SECRET=<user-supplied-Base64-secret-at-least-32-random-bytes>
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
AUTH_COOKIE_SECURE=false
